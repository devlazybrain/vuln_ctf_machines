Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"
  config.vm.hostname = "recovery"

  config.vm.provider "virtualbox" do |vb|
    vb.name   = "lab-m1-recovery"
    vb.memory = 1024
    vb.cpus   = 1
  end

  # Main challenge setup, then neutralise the Vagrant build account.
  config.vm.provision "shell", path: "provision.sh"
  config.vm.provision "shell", path: "../common/finalize.sh"
end
