# Never commit base images, built machines, or VM state — too big / not source
iso/
ova/
*.iso
*.ova
*.box
*.vmdk
*.vdi
.vagrant/

# Build artifacts / archives
*.zip
*.tar
*.tar.gz
*.tgz

# Active build workspace from the other terminal (contains a VM disk + a PRIVATE KEY)
.ctf-build/

# Never commit private keys / secrets
provkey
provkey.pub
*.pem
id_rsa*
id_ed25519*
*.key

# Editor / OS noise
*.swp
.DS_Store

# stray clone from another terminal
_repo_clone/
